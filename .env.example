# Serie A Predictor - Environment Variables
# Copia questo file in .env e inserisci le tue API keys

# football-data.org API v4
# Registrazione gratuita: https://www.football-data.org/client/register
# Free tier: 10 richieste/minuto, Serie A inclusa
FOOTBALL_DATA_ORG_API_KEY=your_key_here

# API-Football (api-sports.io)
# Registrazione gratuita: https://www.api-football.com/
# Free tier: 100 richieste/giorno, include predizioni, quote, statistiche
API_FOOTBALL_KEY=your_key_here

# Opzionale: per scraping FBref con Selenium (se bloccato)
# SELENIUM_DRIVER_PATH=/usr/bin/chromedriver